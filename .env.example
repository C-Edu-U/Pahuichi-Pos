# Copia este archivo como .env para cambiar los valores por defecto.
# .env no se sube al repositorio.

# desarrollo muestra el detalle de los errores; produccion los oculta
APP_ENTORNO=desarrollo

# Puertos en esta PC: https://localhost:8443
PUERTO_HTTPS=8443
PUERTO_HTTP=8080
PUERTO_DB=3307

# Base de datos
DB_NOMBRE=pahuichi
DB_USUARIO=pahuichi
DB_CLAVE=cambia_esta_clave
DB_CLAVE_ROOT=cambia_esta_clave_root

# HU-07: hora diaria en America/La_Paz (24 horas).
BACKUP_HORA=02:00
